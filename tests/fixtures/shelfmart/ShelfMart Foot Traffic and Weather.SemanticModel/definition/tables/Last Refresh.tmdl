/// A table containing information about the last time the dataset was refreshed.  It lists it in the following formats:  dattime, date, year, month, day, time, minute, and second.
table 'Last Refresh'
	lineageTag: 35313593-fa98-4be3-933a-74da8601cc91

	/// The date when the dataset was last refreshed
	measure 'Last Refresh Date' =
			
			SELECTEDVALUE('Last Refresh'[Latest Refresh Date])
		formatString: Short Date
		lineageTag: d49dd941-225c-40c7-b6e8-98f3cbfe0508


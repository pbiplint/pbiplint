{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "paths": {
      "@pbiplint/core": ["./packages/core/src/index.ts"],
      "@pbiplint/core/custom-rules": ["./packages/core/src/custom-rules/index.ts"]
    }
  },
  "include": [
    "packages/*/test",
    "packages/web/e2e",
    "packages/web/playwright.config.ts",
    "tests/support",
    "*.ts"
  ]
}

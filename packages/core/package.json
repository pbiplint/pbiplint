{
  "name": "@pbiplint/core",
  "version": "0.0.0",
  "description": "Best-practice linter core for Power BI semantic models (TMDL). Runs in the browser and in Node.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-notices.mjs",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pbiplint/pbiplint"
  },
  "engines": {
    "node": ">=20"
  }
}

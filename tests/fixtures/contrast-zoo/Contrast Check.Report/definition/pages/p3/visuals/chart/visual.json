{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.8.0/schema.json",
  "name": "chart",
  "position": {
    "x": 440,
    "y": 440,
    "z": 12000,
    "height": 260,
    "width": 800,
    "tabOrder": 12000
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "HierarchyLevel": {
                  "Expression": {
                    "Hierarchy": {
                      "Expression": {
                        "PropertyVariationSource": {
                          "Expression": {
                            "SourceRef": {
                              "Entity": "Customer"
                            }
                          },
                          "Name": "Variation",
                          "Property": "Join Date"
                        }
                      },
                      "Hierarchy": "Date Hierarchy"
                    }
                  },
                  "Level": "Year"
                }
              },
              "queryRef": "Customer.Join Date.Variation.Date Hierarchy.Year",
              "nativeQueryRef": "Join Date Year",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Sales"
                    }
                  },
                  "Property": "Distinct Customers"
                }
              },
              "queryRef": "Sales.Distinct Customers",
              "nativeQueryRef": "Distinct Customers"
            }
          ]
        }
      }
    },
    "objects": {
      "legend": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "24D"
                }
              }
            }
          }
        }
      ],
      "categoryAxis": [
        {
          "properties": {
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "24D"
                }
              }
            },
            "titleFontSize": {
              "expr": {
                "Literal": {
                  "Value": "24D"
                }
              }
            },
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ],
      "valueAxis": [
        {
          "properties": {
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "24D"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {

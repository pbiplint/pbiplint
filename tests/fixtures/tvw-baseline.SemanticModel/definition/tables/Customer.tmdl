table Customer
	lineageTag: 4c4026ea-dbf8-463d-9295-87359757a0d6

	/// Number of distinct customers.
	measure 'Customer Count' = DISTINCTCOUNT(Customer[Customer ID])
		formatString: #,##0
		lineageTag: 665ed3c1-7cc3-49f0-bef1-f3ee1cfe7d45

	column 'Customer ID'
		dataType: int64
		isHidden
		lineageTag: 3e8b35a7-7963-432b-966d-638147506f92
		summarizeBy: none
		sourceColumn: Customer ID

	column 'Customer Name'
		dataType: string
		lineageTag: 5e503464-e8d0-472c-9a30-343f5d6ae3df
		summarizeBy: none
		sourceColumn: Customer Name

	column Segment
		dataType: string
		lineageTag: bd92eb1f-f1c2-42fa-842f-3ddd799b6d24
		summarizeBy: none
		sourceColumn: Segment

	column Region
		dataType: string
		lineageTag: c349a191-9fef-4cb6-9e5f-0c137f4f4d58
		summarizeBy: none
		sourceColumn: Region

	column City
		dataType: string
		lineageTag: 05767b58-a495-4fb0-a238-3233f423f2a9
		dataCategory: City
		summarizeBy: none
		sourceColumn: City

	column State
		dataType: string
		lineageTag: 92b59630-e0c7-4a15-951a-a282fd1a5973
		dataCategory: StateOrProvince
		summarizeBy: none
		sourceColumn: State

	column 'Postal Code'
		dataType: string
		lineageTag: b7240c2f-f1fe-42e1-9c31-63671a5f2905

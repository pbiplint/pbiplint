		summarizeBy: none
		sourceColumn: Postal Code

	column Country
		dataType: string
		lineageTag: ce45a6ba-9e22-4caf-9a77-67b6d77bcba1
		dataCategory: Country
		summarizeBy: none
		sourceColumn: Country

	column Email
		dataType: string
		lineageTag: 74fb8cd5-657d-4e04-8247-507a71a0cc23
		summarizeBy: none
		sourceColumn: Email

	column 'Join Date'
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 80f52695-5bea-4340-834a-5bf29ec319b8
		summarizeBy: none
		sourceColumn: Join Date

		variation Variation
			isDefault
			relationship: f08d5ee4-c9c4-45f3-a3ef-e5b54c3b7d8f
			defaultHierarchy: LocalDateTable_1b2c1fde-0cf3-455e-bfee-a8e4970804e0.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

	column 'Loyalty Tier'
		dataType: string
		lineageTag: f8e5852b-81a2-4663-b178-23fe0df3ac8c
		summarizeBy: none
		sourceColumn: Loyalty Tier

	partition Customer = m
		mode: import
		source =
				let
				    // Read the Customer dimension CSV from the local Data folder
				    Source = Csv.Document(File.Contents("C:\Demo\Data\Customer.csv"), [Delimiter = ",", Columns = 11, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Typed Columns" = Table.TransformColumnTypes(#"Promoted Headers", {
				        {"Customer ID", Int64.Type}, {"Customer Name", type text}, {"Segment", type text}, {"Region", type text},
				        {"City", type text}, {"State", type text}, {"Postal Code", type text}, {"Country", type text},
				        {"Email", type text}, {"Join Date", type date}, {"Loyalty Tier", type text}})
				in
				    #"Typed Columns"


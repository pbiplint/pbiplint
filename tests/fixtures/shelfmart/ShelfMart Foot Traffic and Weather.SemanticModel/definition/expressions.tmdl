expression 'Average High Temperature Summary' =
		let
		    Source = Csv.Document(File.Contents("C:\Demo\Data\AverageHighTemperatureSummary.csv"),[Delimiter=",", Columns=3, Encoding=1252, QuoteStyle=QuoteStyle.None]),
		    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
		    #"Renamed Columns" = Table.RenameColumns(#"Promoted Headers",{{"AverageHighTemperature", "Average High Temperature"}, {"StoreID", "Store ID"}}),
		    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns",{{"Date", type text}, {"Average High Temperature", type number}, {"Store ID", Int64.Type}}),
		    #"Added Key Column" = Table.AddColumn(#"Changed Type", "Key", each Text.Combine({Text.From([Store ID]), [Date]}, "-"), type text)
		in
		    #"Added Key Column"
	lineageTag: 9ec20971-e077-40ec-b21b-f0308b11b6bd

				    #"Added Day Suffix" = Table.AddColumn(#"Added Day of Month", "Day Suffix", each Number.ToText([Day of Month]) & (if List.Contains({11, 12, 13}, [Day of Month]) then "th" else if List.Contains({1, 21, 31}, [Day of Month]) then "st" else if List.Contains({2, 22}, [Day of Month]) then "nd" else if List.Contains({3, 23}, [Day of Month]) then "rd" else "th"), type text),
				    #"Added Day of Week" = Table.AddColumn(#"Added Day Suffix", "Day of Week", each Date.DayOfWeek([Date], 0) + 1, Int64.Type),
				    #"Added Day Name" = Table.AddColumn(#"Added Day of Week", "Day Name", each Date.DayOfWeekName([Date]), type text),
				    #"Added Day of Week in Month" = Table.AddColumn(#"Added Day Name", "Day of Week in Month", each Date.WeekOfMonth([Date]), Int64.Type),
				    #"Added Day of Week in Year" = Table.AddColumn(#"Added Day of Week in Month", "Day of Week in Year", each Date.WeekOfYear([Date]), Int64.Type),
				    #"Added Day of Quarter" = Table.AddColumn(#"Added Day of Week in Year", "Day of Quarter", each Duration.Days([Date] - Date.StartOfQuarter([Date])) + 1, Int64.Type),
				    #"Added Day of Year" = Table.AddColumn(#"Added Day of Quarter", "Day of Year", each Duration.Days([Date] - Date.StartOfYear([Date])) + 1, Int64.Type),
				    #"Added Week of Month" = Table.AddColumn(#"Added Day of Year", "Week of Month", each Date.WeekOfMonth([Date]), Int64.Type),
				    #"Added Week of Year" = Table.AddColumn(#"Added Week of Month", "Week of Year", each Date.WeekOfYear([Date]), Int64.Type),
				    #"Added Month" = Table.AddColumn(#"Added Week of Year", "Month", each Date.Month([Date]), Int64.Type),
				    #"Added Month Name" = Table.AddColumn(#"Added Month", "Month Name", each Date.MonthName([Date]), type text),
				    #"Added Month Short Name" = Table.AddColumn(#"Added Month Name", "Month Short Name", each Text.Start([Month Name], 3), type text),
				    #"Added Month of Quarter" = Table.AddColumn(#"Added Month Short Name", "Month of Quarter", each if List.Contains({1, 4, 7, 10}, [Month]) then 1 else if List.Contains({2, 5, 8, 11}, [Month]) then 2 else if List.Contains({3, 6, 9, 12}, [Month]) then 3 else 0, Int64.Type),
				    #"Added Quarter" = Table.AddColumn(#"Added Month of Quarter", "Quarter", each Date.QuarterOfYear([Date]), Int64.Type),
				    #"Added Quarter Name" = Table.AddColumn(#"Added Quarter", "Quarter Name", each if [Quarter] = 1 then "First" else if [Quarter] = 2 then "Second" else if [Quarter] = 3 then "Third" else if [Quarter] = 4 then "Fourth" else "", type text),
				    #"Added Year" = Table.AddColumn(#"Added Quarter Name", "Year", each Date.Year([Date]), Int64.Type),
				    #"Added Year Name" = Table.AddColumn(#"Added Year", "Year Name", each "CY" & Number.ToText([Year]), type text),
				    #"Added Short Month-Year" = Table.AddColumn(#"Added Year Name", "Short Month-Year", each Text.Start([Month Name], 3) & "-" & Number.ToText([Year]), type text),
				    #"Added Short Month-Short Year" = Table.AddColumn(#"Added Short Month-Year", "Short Month-Short Year", each Text.Start([Month Name], 3) & "-" & Text.End(Number.ToText([Year]), 2), type text),
				    #"Added  MMYYYY" = Table.AddColumn(#"Added Short Month-Short Year", "MMYYYY", each Number.ToText([Month], "00") & Number.ToText([Year]), type text),
				    #"Added YYYYMM" = Table.AddColumn(#"Added  MMYYYY", "YYYYMM", each [Year] * 100 + [Month], Int64.Type),
				    #"Added First Day of Previous Month" = Table.AddColumn(#"Added YYYYMM", "First Day of Previous Month", each Date.StartOfMonth(Date.From(Date.AddMonths([Date], -1))), type date),
				    #"Added Last Day of Previous Month" = Table.AddColumn(#"Added First Day of Previous Month", "Last Day of Previous Month", each Date.EndOfMonth(Date.AddMonths([Date], -1)), type date),

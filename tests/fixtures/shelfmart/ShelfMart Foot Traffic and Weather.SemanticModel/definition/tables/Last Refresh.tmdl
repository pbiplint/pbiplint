	/// Creates a dynamic statement of the date and time when the dataset was last refreshed.  E.g., "Data last refreshed on 3/14/2001 at 1:30:55 PM"
	measure 'Last Refresh Text' =
			
			"Data last refreshed on " & [Last Refresh Date] & " at " & [Last Refresh Time]
		lineageTag: 78ffc6f5-c825-46d8-ac7e-d122950d9f21


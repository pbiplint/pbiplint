				    #"Added Last Day of Previous Year" = Table.AddColumn(#"Added First Day of Previous Year", "Last Day of Previous Year", each Date.AddDays(Date.StartOfYear([Date]), -1), type date),
				    #"Added First Day of Year" = Table.AddColumn(#"Added Last Day of Previous Year", "First Day of Year", each Date.StartOfYear([Date]), type date),
				    #"Added Last Day of Year" = Table.AddColumn(#"Added First Day of Year", "Last Day of Year", each Date.EndOfYear([Date]), type date),

{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "14089948551686980878"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region for the storage account. The private endpoints go in the virtual network's own region."
      }
    },
    "storageAccountName": {
      "type": "string",
      "defaultValue": "[format('pbiplint{0}', uniqueString(resourceGroup().id))]",
      "minLength": 3,
      "maxLength": 24,
      "metadata": {
        "description": "Name of the storage account: 3 to 24 lowercase letters and digits, unique across Azure."
      }
    },
    "subnetId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of an existing subnet in this subscription that the private endpoints join. It may be in another resource group."
      }
    },
    "networkLocation": {
      "type": "string",
      "metadata": {
        "description": "Region of that subnet's virtual network; private endpoints must be in it. The portal form fills it in."
      }
    },
    "dnsMode": {
      "type": "string",
      "defaultValue": "create",
      "allowedValues": [
        "create",
        "existing",
        "none"
      ],
      "metadata": {
        "description": "How the private DNS records are made: create the two privatelink zones here, use existing zones, or none because the firm's own policy writes them."
      }
    },
    "webDnsZoneId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "With dnsMode existing: resource ID of the privatelink.web.core.windows.net zone."
      }
    },
    "blobDnsZoneId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "With dnsMode existing: resource ID of the privatelink.blob.core.windows.net zone."
      }
    },
    "logAnalyticsWorkspaceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Resource ID of a Log Analytics workspace for blob write and delete events. Blank sends none."
      }
    },
    "writeGroupObjectId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Object ID of the Entra group that may change the site's files. Blank assigns nothing."
      }
    }
  },
  "variables": {
    "subnetParts": "[split(parameters('subnetId'), '/')]",
    "vnetId": "[resourceId(variables('subnetParts')[2], variables('subnetParts')[4], 'Microsoft.Network/virtualNetworks', variables('subnetParts')[8])]",
    "services": [
      "web",
      "blob"
    ],
    "existingZones": {
      "web": "[parameters('webDnsZoneId')]",
      "blob": "[parameters('blobDnsZoneId')]"
    },
    "storageBlobDataContributor": "ba92f5b4-2d11-453d-a403-e96b0029c9fe"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2025-08-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[parameters('location')]",
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      },
      "properties": {
        "publicNetworkAccess": "Disabled",
        "allowSharedKeyAccess": false,
        "defaultToOAuthAuthentication": true,
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false,
        "supportsHttpsTrafficOnly": true,
        "networkAcls": {
          "defaultAction": "Deny",
          "bypass": "None"
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2025-08-01",
      "name": "[format('{0}/{1}', parameters('storageAccountName'), 'default')]",
      "properties": {
        "staticWebsite": {
          "enabled": true,
          "indexDocument": "index.html",
          "errorDocument404Path": "404.html"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ]
    },
    {
      "copy": {
        "name": "endpoints",
        "count": "[length(variables('services'))]"
      },
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}-{1}', parameters('storageAccountName'), variables('services')[copyIndex()])]",
      "location": "[parameters('networkLocation')]",
      "properties": {
        "subnet": {
          "id": "[parameters('subnetId')]"
        },
        "privateLinkServiceConnections": [
          {
            "name": "[format('{0}-{1}', parameters('storageAccountName'), variables('services')[copyIndex()])]",
            "properties": {
              "privateLinkServiceId": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
              "groupIds": [
                "[variables('services')[copyIndex()]]"
              ]
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ]
    },
    {
      "copy": {
        "name": "zones",
        "count": "[length(variables('services'))]"
      },
      "condition": "[equals(parameters('dnsMode'), 'create')]",
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2024-06-01",
      "name": "[format('privatelink.{0}.{1}', variables('services')[copyIndex()], environment().suffixes.storage)]",
      "location": "global"
    },
    {
      "copy": {
        "name": "links",
        "count": "[length(variables('services'))]"
      },
      "condition": "[equals(parameters('dnsMode'), 'create')]",
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2024-06-01",
      "name": "[format('{0}/{1}', format('privatelink.{0}.{1}', variables('services')[copyIndex()], environment().suffixes.storage), format('{0}-link', variables('subnetParts')[8]))]",
      "location": "global",
      "properties": {
        "registrationEnabled": false,
        "resolutionPolicy": "NxDomainRedirect",
        "virtualNetwork": {
          "id": "[variables('vnetId')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', format('privatelink.{0}.{1}', variables('services')[copyIndex()], environment().suffixes.storage))]"
      ]
    },
    {
      "copy": {
        "name": "zoneGroups",
        "count": "[length(variables('services'))]"
      },
      "condition": "[not(equals(parameters('dnsMode'), 'none'))]",
      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}/{1}', format('{0}-{1}', parameters('storageAccountName'), variables('services')[copyIndex()]), 'default')]",
      "properties": {
        "privateDnsZoneConfigs": [
          {
            "name": "[variables('services')[copyIndex()]]",
            "properties": {
              "privateDnsZoneId": "[if(equals(parameters('dnsMode'), 'create'), resourceId('Microsoft.Network/privateDnsZones', format('privatelink.{0}.{1}', variables('services')[copyIndex()], environment().suffixes.storage)), variables('existingZones')[variables('services')[copyIndex()]])]"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateEndpoints', format('{0}-{1}', parameters('storageAccountName'), variables('services')[copyIndex()]))]",
        "[resourceId('Microsoft.Network/privateDnsZones', format('privatelink.{0}.{1}', variables('services')[copyIndex()], environment().suffixes.storage))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/locks",
      "apiVersion": "2020-05-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
      "name": "[format('{0}-no-delete', parameters('storageAccountName'))]",
      "properties": {
        "level": "CanNotDelete",
        "notes": "pbiplint: remove this lock before deleting the site on purpose."
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ]
    },
    {
      "condition": "[not(empty(parameters('logAnalyticsWorkspaceId')))]",
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts/blobServices', parameters('storageAccountName'), 'default')]",
      "name": "pbiplint-writes-and-deletes",
      "properties": {
        "workspaceId": "[parameters('logAnalyticsWorkspaceId')]",
        "logs": [
          {
            "category": "StorageWrite",
            "enabled": true
          },
          {
            "category": "StorageDelete",
            "enabled": true
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', parameters('storageAccountName'), 'default')]"
      ]
    },
    {
      "condition": "[not(empty(parameters('writeGroupObjectId')))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', parameters('storageAccountName'), 'default', '$web')]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', parameters('storageAccountName'), 'default', '$web'), parameters('writeGroupObjectId'), variables('storageBlobDataContributor'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageBlobDataContributor'))]",
        "principalId": "[parameters('writeGroupObjectId')]",
        "principalType": "Group"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', parameters('storageAccountName'), 'default')]"
      ]
    }
  ],
  "outputs": {
    "siteUrl": {
      "type": "string",
      "metadata": {
        "description": "The site's address, reachable only from inside the network."
      },
      "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2025-08-01').primaryEndpoints.web]"
    },
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "The storage account the upload commands name."
      },
      "value": "[parameters('storageAccountName')]"
    }
  }
}
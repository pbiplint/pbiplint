/// Credentials written into a query, every value a made-up fixture string, beside the shapes that hold none.
table 'Api Secrets'
	lineageTag: 6c0f5a1e-0002-4000-8000-00000000000d

	column Content
		dataType: binary
		summarizeBy: none
		sourceColumn: Content

	partition 'Api Secrets' = m
		mode: import
		source =
				let
					// An old key, pbiplint-fixture-key-0006-notreal, kept in a comment.
					HeaderToken = Web.Contents("https://api.example.com/v1/orders", [Headers = [Authorization = "Bearer pbiplint-fixture-token-0001-notreal"]]),
					UrlKey = Web.Contents("https://api.example.com/v1/orders?api_key=pbiplint-fixture-key-0002-notreal"),
					QueryKey = Web.Contents("https://api.example.com/v1/orders", [Query = [apikey = "pbiplint-fixture-key-0003-notreal"]]),
					ParameterToken = Web.Contents("https://api.example.com/v1/customers", [Headers = [#"x-api-key" = ServiceToken]]),
					NamedKey = Web.Contents("https://api.example.com/v1/orders", [ApiKeyName = "api_key"]),
					Placeholder = Web.Contents("https://api.example.com/v1/orders", [Headers = [Authorization = "<your key>"]]),
					Contents = #table(type table [Content = binary], {{HeaderToken}, {UrlKey}, {QueryKey}, {ParameterToken}, {NamedKey}, {Placeholder}})
				in
					Contents

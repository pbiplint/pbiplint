model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Orders","Targets"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Orders
ref table Targets
ref table Calendar


{
  "name": "pbip-lint",
  "version": "0.1.0",
  "description": "Alias for pbiplint. Installs and runs pbiplint, the best-practice linter for Power BI semantic models (TMDL).",
  "keywords": [
    "power-bi",
    "tmdl",
    "semantic-model",
    "pbip",
    "linter",
    "best-practices",
    "cli"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "McKinley Consulting",
  "homepage": "https://pbiplint.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pbiplint/pbiplint.git",
    "directory": "packages/alias"
  },
  "bugs": {
    "url": "https://github.com/pbiplint/pbiplint/issues"
  },
  "type": "module",
  "bin": {
    "pbip-lint": "./bin/pbip-lint.mjs"
  },
  "dependencies": {
    "pbiplint": "0.1.0"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/copy-license.mjs",
    "prepack": "npm run build",
    "test:bundle": "node bin/pbip-lint.mjs --sample --format json > /dev/null; test $? -eq 1"
  },
  "engines": {
    "node": ">=20"
  }
}

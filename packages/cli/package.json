{
  "name": "pbiplint",
  "version": "0.0.0",
  "description": "Lint Power BI semantic models (TMDL) for best-practice violations. Nothing is uploaded.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pbiplint": "./dist/pbiplint.mjs"
  },
  "files": [
    "dist",
    "sample",
    "NOTICE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test:bundle": "node dist/pbiplint.mjs --sample --format json > /dev/null; test $? -eq 1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pbiplint/pbiplint"
  },
  "engines": {
    "node": ">=20"
  }
}

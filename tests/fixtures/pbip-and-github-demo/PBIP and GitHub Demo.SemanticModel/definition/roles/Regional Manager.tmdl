/// Dynamic RLS — viewer sees only customers in the regions their email is mapped to via the disconnected User Region table. Different users get different filter sets without separate role definitions.
role 'Regional Manager'
	modelPermission: read

	tablePermission Customer =
			'Customer'[Region] IN
			    CALCULATETABLE (
			        VALUES ( 'User Region'[Region] ),
			        'User Region'[User Email] = USERPRINCIPALNAME ()
			    )

	annotation PBI_Id = 5e7374faef9c57dfb8ebacb5330f6101


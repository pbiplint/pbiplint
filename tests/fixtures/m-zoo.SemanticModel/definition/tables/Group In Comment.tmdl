/// A function name only in a comment, which a text match counts and the parsed M does not.
table 'Group In Comment'
	lineageTag: 6c0f5a1e-0002-4000-8000-00000000001a

	column OrderID
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: OrderID

	partition 'Group In Comment' = m
		mode: import
		source =
				let
					// Grouping moved to the view: Table.Group(Orders, {"OrderID"}, {}) is no longer needed.
					Source = Sql.Database(ServerName, "Warehouse"),
					Orders = Source{[Schema="dbo",Item="vwOrderTotals"]}[Data]
				in
					Orders

table Notes

	annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["ENSURE_TABLES_HAVE_RELATIONSHIPS","PROBE_IGNORE_CUSTOM"]}

	measure 'Note Count' = COUNTROWS(Notes)
		formatString: #,0

	column Note
		dataType: string
		summarizeBy: none
		sourceColumn: Note

	partition Notes = m
		mode: import
		source =
				let
				    Source = Table.FromRows({{"First note"}}, {"Note"})
				in
				    Source

/// Only Desktop's Source and Navigation steps, which name what they are.
table 'Navigation Only'
	lineageTag: 6c0f5a1e-0002-4000-8000-000000000015

	column OrderID
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: OrderID

	partition 'Navigation Only' = m
		mode: import
		source =
				let
					Source = Sql.Database(ServerName, "Warehouse"),
					Navigation = Source{[Schema="dbo",Item="Orders"]}[Data]
				in
					Navigation

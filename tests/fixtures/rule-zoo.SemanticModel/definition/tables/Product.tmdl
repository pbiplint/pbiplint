table Product

	column 'Product ID'
		dataType: int64
		isKey
		summarizeBy: none
		sourceColumn: Product ID

	column 'Product Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Product Name

	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: Category

	hierarchy 'by Category'

		level ' Category'
			column: Category

		level 'Product Name'
			column: 'Product Name'

	partition Product = m
		mode: import
		source =
				let
				    Source = Table.FromRows({})
				in
				    Source
